# This .gitignore lives at the repo root, but the Unity project itself is
# in the OlfactOasis-Experience/ subfolder (the root also holds Blender
# files, References/, etc. that are NOT part of the Unity project).
#
# Adapted from https://github.com/github/gitignore/blob/main/Unity.gitignore
# by anchoring the Unity-specific folder rules to OlfactOasis-Experience/.
#
.utmp/
/OlfactOasis-Experience/[Ll]ibrary/
/OlfactOasis-Experience/[Tt]emp/
/OlfactOasis-Experience/[Oo]bj/
/OlfactOasis-Experience/[Bb]uild/
/OlfactOasis-Experience/[Bb]uilds/
/OlfactOasis-Experience/[Ll]ogs/
/OlfactOasis-Experience/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/OlfactOasis-Experience/[Mm]emoryCaptures/

# Recordings can get excessive in size
/OlfactOasis-Experience/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /OlfactOasis-Experience/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/OlfactOasis-Experience/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/OlfactOasis-Experience/ServerData
/OlfactOasis-Experience/[Aa]ssets/StreamingAssets/aa*
/OlfactOasis-Experience/[Aa]ssets/AddressableAssetsData/link.xml*
/OlfactOasis-Experience/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /OlfactOasis-Experience/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/OlfactOasis-Experience/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/OlfactOasis-Experience/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/OlfactOasis-Experience/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/OlfactOasis-Experience/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/OlfactOasis-Experience/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/OlfactOasis-Experience/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/OlfactOasis-Experience/[Aa]ssets/[Ss]ceneDependencyCache*
